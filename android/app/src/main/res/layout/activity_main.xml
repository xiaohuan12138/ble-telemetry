<?xml version="1.0" encoding="utf-8"?>
<!-- 单 Activity：上面装 Fragment 的容器，下面是底部导航。
     BottomNavigationView 与 Navigation 组件绑定后，tab 切换/回退栈全自动 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ AI 助手浮窗球 ═══
         ConstraintLayout 的子 View 位置由约束决定，想自由拖动就绕过约束：
         ConstraintLayout 内放一个不支持约束定位的容器（FrameLayout + layout_gravity）
         行不通——这里直接用 translationX/Y 偏移：View 初始位置固定在右下角约束点，
         拖动时改 translationX/Y（不影响约束，只加偏移），零测量冲突 -->
    <FrameLayout
        android:id="@+id/assistBall"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_assist_ball"
        android:contentDescription="@string/assist_ball_desc"
        android:elevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/assist_ball_desc"
            android:src="@drawable/ic_assist"
            app:tint="#FFFFFFFF" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
