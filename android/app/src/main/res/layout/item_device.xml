<?xml version="1.0" encoding="utf-8"?>
<!-- 列表项：设备名 + MAC + 信号强度条 + 连接按钮
     点击整行进入详情页（列表 → 详情，这是课程要求的跳转结构） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- 左侧：蓝牙图标芯片 + 信号强度指示（三格竖条，高度由代码按 RSSI 设置） -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_chip">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/devices_title"
            android:src="@drawable/ic_bluetooth"
            app:tint="@color/primary" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <View
            android:id="@+id/bar1"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_status_dot" />

        <View
            android:id="@+id/bar2"
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_status_dot" />

        <View
            android:id="@+id/bar3"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_dot" />

    </LinearLayout>

    <!-- 中间：名字和地址 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SensorHub-01"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24:0A:C4:00:00:01"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 右侧：状态标签 -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
