<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：C1 拍照用。声明 required=false，无相机设备（部分模拟器）仍可安装 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 批量处理完成后的系统通知（Android 13+ 需运行时请求） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 12 及以下读媒体仍需存储权限；13+ 用照片选择器，无需权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".PixelLabApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelLab"
        tools:targetApi="37">

        <!-- 单 Activity 多 Fragment：跳转、回退栈、动画全交给 Navigation -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider：P4 分享卡片要把它生成的图片安全地交给微信/QQ 等外部 App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.pixellab.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- P1 桌面小组件：主屏展示最近处理图 + 一键打开 -->
        <receiver
            android:name=".widget.RecentWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>
    </application>
</manifest>
